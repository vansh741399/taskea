# Environment variables example
# Copy this file to .env and fill in your values

# Database URL (PostgreSQL connection string)
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# Direct URL (for Prisma migrations - same as DATABASE_URL for most setups)
DIRECT_URL="postgresql://user:password@host:port/database?sslmode=require"

# v25·0806 — HRMS access token for fetching employee master data
HRMS_BASE_URL="https://laxree-hrms.vercel.app"
HRMS_ACCESS_TOKEN="your-hrms-access-token-here"
